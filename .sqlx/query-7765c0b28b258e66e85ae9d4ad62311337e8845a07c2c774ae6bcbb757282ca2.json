  "query": "INSERT INTO days (user_id, date, weight_kg, target_calories, notes, weight_logged_at)\n             VALUES (\n                 (SELECT id FROM users WHERE name = $1), $2, $3, $4, $5,\n                 CASE WHEN $3::real IS NULL THEN NULL ELSE now() END\n             )\n             RETURNING *",
